# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
#
#   cp .env.local.example .env.local      (macOS / Linux / Git Bash)
#   copy .env.local.example .env.local    (Windows cmd)
#
# `.env.local` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Legacy `anon` JWT also works.
# This one is exposed to the browser, so it MUST be the low-privilege key:
# it is used only for Realtime reads and is constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). Legacy `service_role` JWT also works.
# SERVER-ONLY. It bypasses Row Level Security, so it must never be prefixed
# with NEXT_PUBLIC_ and must never be imported into client components.
SUPABASE_SECRET_KEY=

# Public base URL of this app. Encoded into the patient QR code.
# Use http://localhost:3000 for desktop demos, or the machine's LAN IP
# (e.g. http://192.168.1.42:3000) so phones can scan and join.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. When set, staff/admin routes require this PIN.
# Leave empty to disable the gate (recommended for the hackathon demo).
STAFF_PIN=
